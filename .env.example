# DigiTronics — Docker Compose environment
# Copy to .env next to docker-compose.yml. .env is gitignored; never commit it.

# REQUIRED — JWT signing secret for production
JWT_SECRET=change-me-to-a-long-random-string

# Optional overrides
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
AUTH_REQUIRED=false
CORS_ORIGINS=
RATE_LIMIT_MAX=1000
BODY_LIMIT=10mb
LOG_FILE=
SLOW_REQUEST_MS=1000

# Host port mappings
BACKEND_PORT=3001
HTTP_PORT=80
