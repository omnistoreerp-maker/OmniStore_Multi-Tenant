# ---- GoLive-1 baseline: non-source artifacts / build outputs ----
releases/
release/
backups/
archive/
test-results/
*.bak*
*.log
backend/login.json
backend/sale.json
backend/jest-results.json
backend/.env
backend/.env.local

# Runtime JSON stores (regenerated on every run — never version them)
backend/data/apiKeys.json
backend/data/auditLog.json
backend/data/users.json
backend/data/platformAdmins.json
backend/data/gameHostingPlans.json
backend/data/gameHostingServers.json
backend/data/marketCustomers.json
backend/data/gameHostingOrders.json
backend/data/reels-*.json
backend/data/reel-media/
# TikTok Display API: holds server-side access/refresh tokens and the cached
# public video metadata. Must never be committed.
backend/data/tiktokConnection.json
backend/data/reelsCache.json

# Education module: tenant-owned runtime stores, created on first write and
# never committed. Same rule as the entries above.
backend/data/educationPack.json
backend/data/educationStudents.json
backend/data/educationTeachers.json
backend/data/educationCenters.json
backend/data/educationPrograms.json
backend/data/educationCourses.json
backend/data/educationClasses.json
backend/data/educationEnrollments.json
backend/data/educationAssignments.json
backend/data/educationAssignmentSubmissions.json
backend/data/educationAttendance.json
backend/data/educationScheduling.json
backend/data/educationGrading.json
# Written by the mounted booking + rating routers (server.js:434-435). These
# hold teacher<->student bookings and free-text performance feedback, so they
# must never reach git.
backend/data/educationBookings.json
backend/data/educationRatings.json

# P6 F5: SQLite token store (session families, refresh rotation, revocation
# denylist, replay audit). Contains live session metadata and is created on
# first boot, so it must never be committed. WAL/SHM companions are likewise
# runtime-only, as are the automatic pre-migration backups.
backend/data/tokenStore.sqlite
backend/data/tokenStore.sqlite-wal
backend/data/tokenStore.sqlite-shm
backend/data/tokenStore.sqlite.*.bak
backend/data/tokenStore.sqlite.lock
backend/data/tokenStore.sqlite.restore.*
backend/data/tokenStore.sqlite.rollback.*
backend/data/.token_store_initialized
backend/data/revoked-tokens.json.migrated.*
