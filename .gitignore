# Runtime JSON stores (regenerated on every run — never version them)
backend/data/apiKeys.json
backend/data/auditLog.json
backend/data/users.json
# Platform admin store: seeded on development/test boot, never versioned.
backend/data/platformAdmins.json
backend/data/gameHostingPlans.json
backend/data/gameHostingServers.json
backend/data/marketCustomers.json
backend/data/gameHostingOrders.json
backend/data/reels-*.json
backend/data/reel-media/
# TikTok Display API: holds server-side access/refresh tokens and the cached
# public video metadata. Must never be committed.
backend/data/tiktokConnection.json
backend/data/reelsCache.json

# Education module: tenant-owned runtime stores, created on first write and
# never committed. Same rule as the entries above.
backend/data/educationPack.json
backend/data/educationStudents.json
backend/data/educationTeachers.json
backend/data/educationCenters.json
backend/data/educationPrograms.json
backend/data/educationCourses.json
backend/data/educationClasses.json
backend/data/educationEnrollments.json
backend/data/educationAttendance.json
backend/data/educationScheduling.json
backend/data/educationGrading.json
