{
  "$schema": "https://json.schemastore.org/design-token",
  "brand": {
    "name": "OmniStore",
    "product": "OmniStore ERP",
    "version": "1.0.0",
    "logo": "brand/logo/omnistore-logo-connected-o.svg",
    "logoSafeArea": "16px",
    "logoViewBox": "0 0 200 200"
  },
  "colors": {
    "legacy": {
      "primary": "#2563eb",
      "primaryHover": "#1d4ed8",
      "primaryLight": "#eef2ff",
      "secondary": "#0f172a",
      "secondaryLight": "#f8fafc",
      "surface": "#ffffff",
      "surfaceAlt": "#f1f5f9",
      "textPrimary": "#0f172a",
      "textSecondary": "#475569",
      "textMuted": "#94a3b8",
      "success": "#16a34a",
      "warning": "#d97706",
      "danger": "#dc2626",
      "info": "#2563eb"
    },
    "brand": {
      "navy": "#0B1F44",
      "navyHover": "#0A1833",
      "navyLight": "#E8ECF5",
      "teal": "#00C2B3",
      "tealHover": "#00A9A0",
      "tealLight": "#E3FCFA",
      "blue": "#4F7CFF",
      "blueHover": "#3A6BFF",
      "blueLight": "#E9EFFF",
      "violet": "#A78BFA",
      "violetHover": "#9370EA",
      "violetLight": "#F3E8FF"
    },
    "semantic": {
      "success": "#16a34a",
      "successLight": "#DCFCE7",
      "warning": "#d97706",
      "warningLight": "#FEF3C7",
      "danger": "#dc2626",
      "dangerLight": "#FEE2E2",
      "info": "#4F7CFF",
      "infoLight": "#E9EFFF"
    },
    "neutral": {
      "background": "#ffffff",
      "surface": "#f8fafc",
      "surfaceAlt": "#f1f5f9",
      "border": "#e2e8f0",
      "borderHover": "#cbd5e1",
      "textPrimary": "#0f172a",
      "textSecondary": "#475569",
      "textMuted": "#94a3b8",
      "textInverse": "#ffffff",
      "placeholder": "#cbd5e1"
    }
  },
  "typography": {
    "fontFamily": {
      "arabic": "'IBM Plex Sans Arabic', 'Segoe UI', -apple-system, Roboto, Helvetica, Arial, sans-serif",
      "latin": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem"
    },
    "lineHeight": {
      "tight": 1.25,
      "normal": 1.5,
      "relaxed": 1.75
    },
    "letterSpacing": {
      "tight": "-0.025em",
      "normal": "0",
      "wide": "0.025em"
    }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "xxl": "48px",
    "xxxl": "64px"
  },
  "borderRadius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "shadows": {
    "sm": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
    "md": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
    "lg": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
    "xl": "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)"
  },
  "breakpoints": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "xxl": "1536px"
  },
  "zIndex": {
    "dropdown": 100,
    "sticky": 200,
    "modal": 300,
    "tooltip": 400,
    "toast": 500
  },
  "icons": {
    "library": "lucide",
    "style": "stroke",
    "strokeWidth": 2,
    "size": {
      "sm": "16px",
      "md": "20px",
      "lg": "24px",
      "xl": "32px"
    }
  },
  "transitions": {
    "fast": "150ms ease-in-out",
    "normal": "250ms ease-in-out",
    "slow": "350ms ease-in-out"
  },
  "layout": {
    "headerHeight": "64px",
    "footerHeight": "56px",
    "sidebarWidth": "256px",
    "contentMaxWidth": "1200px",
    "containerPadding": "16px"
  },
  "darkMode": {
    "enabled": true,
    "colors": {
      "background": "#0f172a",
      "surface": "#1e293b",
      "surfaceAlt": "#334155",
      "border": "#334155",
      "borderHover": "#475569",
      "textPrimary": "#f8fafc",
      "textSecondary": "#cbd5e1",
      "textMuted": "#94a3b8",
      "textInverse": "#0f172a"
    }
  },
  "rtl": {
    "enabled": true,
    "defaultLanguage": "ar",
    "defaultDirection": "rtl",
    "supportedLanguages": ["ar", "en"],
    "logicalProperties": true
  }
}
