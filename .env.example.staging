# DigiTronics — Staging environment (for P6.85 Universal Google Login Staging Readiness)
# This file supplements .env.example for staging HTTPS deployments.

# === Authentication ===
# Staging must have AUTH_REQUIRED=true — never run staging publicly with AUTH_REQUIRED=false
AUTH_REQUIRED=true

# === Google OAuth (STAGING) ===
# Staging uses HTTPS but is NOT production — set these for Google Login to work
GOOGLE_CLIENT_ID=your-staging-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-staging-client-secret
GOOGLE_CALLBACK_URL=https://staging.omnistoreerp.com/auth/google/callback

# === Session Cookie Security (P6.85) ===
# staging: secure=true, sameSite=none (requires secure)
# production: secure=true, sameSite=none (requires secure)  
# development: secure=false, sameSite=lax
NODE_ENV=staging

# === Platform Domain ===
PLATFORM_DOMAIN=staging.omnistoreerp.com

# === Rate limiting / security ===
RATE_LIMIT_MAX=1000
BODY_LIMIT=10mb
STAGING=true

# === Optional: CORS for staging ===
CORS_ORIGINS=https://staging.omnistoreerp.com

# === Challenge Store ===
# Path to SQLite challenge database — must be a persistent, writable directory
# that survives process restarts. The directory must already exist; the path
# must be absolute or relative to the project root.
#
# Production: set CHALLENGE_DB_PATH to a persistent path (e.g. ./data/challenges.sqlite)
# Staging:    set CHALLENGE_DB_PATH to a persistent path within the staging environment
# Development: leave unset — will use a temporary path in os.tmpdir()
#
# WARNING: In production, CHALLENGE_DB_PATH is REQUIRED. Omitting it will cause
#            validateStartupConfiguration() to fail at boot.
#
CHALLENGE_DB_PATH=./data/challenges.sqlite
