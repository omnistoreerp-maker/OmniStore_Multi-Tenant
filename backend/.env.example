# DigiTronics Backend — Environment Configuration
# Copy to .env and adjust. .env is gitignored and must never be committed.

# Server
PORT=3001
NODE_ENV=development          # development | production

# Authentication / JWT
# REQUIRED in production — the server warns on boot if left as the default.
JWT_SECRET=your-secret-key-change-in-production
JWT_REFRESH_SECRET=           # optional; defaults to JWT_SECRET + ':refresh'
JWT_ACCESS_TTL=15m            # access token lifetime
JWT_REFRESH_TTL=7d            # refresh token lifetime

# Route protection
# PRODUCTION IS FAIL-CLOSED: with NODE_ENV=production and this line unset the
# server boots with AUTH_REQUIRED=true. An explicit value always wins, so
# AUTH_REQUIRED=false is still honored (the documented Koyeb first-Owner
# bootstrap uses it) — but forgetting the variable in production can no
# longer leave every /api/v1 business route open. DEV/TEST default (unset)
# stays OFF = legacy local behavior.
# When true: all /api/v1 business routes require a Bearer token;
# non-GET requests additionally require role Owner, Admin or Manager.
# AUTH_REQUIRED=true

# Tenant isolation (all six) — production default ON (fail-closed), dev/test
# default OFF. Explicit values always win; only disable deliberately.
# ENABLE_TENANT_RESOLUTION=true
# ENABLE_TENANT_METADATA=true
# ENABLE_TENANT_FILTERING=true
# ENABLE_TENANT_ENTITY_ISOLATION=true
# ENABLE_TENANT_SALES_ISOLATION=true
# ENABLE_TENANT_PURCHASES_ISOLATION=true

# API security
CORS_ORIGINS=                 # comma-separated allowlist; empty = open (legacy default)
RATE_LIMIT_MAX=1000           # requests per 15 minutes per IP
BODY_LIMIT=10mb               # max JSON body size

# Logging
LOG_FILE=                     # optional file path for structured logs
SLOW_REQUEST_MS=1000          # slow-request threshold for performance logging

# Supabase (legacy integration, optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
