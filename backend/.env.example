# DigiTronics Backend — Environment Configuration
# Copy to .env and adjust. .env is gitignored and must never be committed.

# Server
PORT=3001
NODE_ENV=development          # development | production

# Authentication / JWT
# REQUIRED in production — the server warns on boot if left as the default.
JWT_SECRET=your-secret-key-change-in-production
JWT_REFRESH_SECRET=           # optional; defaults to JWT_SECRET + ':refresh'
JWT_ACCESS_TTL=15m            # access token lifetime
JWT_REFRESH_TTL=7d            # refresh token lifetime

# Route protection (default OFF = legacy open behavior)
# When true: all /api/v1 business routes require a Bearer token;
# non-GET requests additionally require role Owner, Admin or Manager.
AUTH_REQUIRED=false

# API security
CORS_ORIGINS=                 # comma-separated allowlist; empty = open (legacy default)
RATE_LIMIT_MAX=1000           # requests per 15 minutes per IP
BODY_LIMIT=10mb               # max JSON body size

# Logging
LOG_FILE=                     # optional file path for structured logs
SLOW_REQUEST_MS=1000          # slow-request threshold for performance logging

# Supabase (legacy integration, optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# TikTok Display API (Login Kit + Display API) — Reels feed.
# All values are EMPTY on purpose. Never commit a real credential: this file is
# a template, and .env is gitignored.
# Setup (TikTok for Developers):
#   1. Register a Developer App and add the Login Kit + Display API products.
#   2. Request the `video.list` scope (and `user.info.basic` for the account
#      diagnostic). Submit the app for review; sandbox mode is available first.
#   3. Register a STATIC absolute https redirect URI (no query string, no
#      fragment, max 10, under 512 chars).
#   4. Fill the values below ONLY in the real .env, then sign in as a PLATFORM
#      ADMIN and open the authenticated endpoint
#      /api/v1/platform-public/tiktok/connect to approve consent as the
#      account owner. That endpoint is deliberately NOT linked from the public
#      Reels page: authorizing the account is an administrator action.
# The authorized TikTok account is the source of truth for identity; there is
# deliberately no hardcoded handle.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# Optional: narrow the requested scopes (video.list is always kept).
# TIKTOK_REELS_SCOPES=user.info.basic,video.list
# Optional: override the documented upstream endpoints (testing only).
# TIKTOK_AUTHORIZE_URL=
# TIKTOK_TOKEN_URL=
# TIKTOK_USER_INFO_URL=
# TIKTOK_VIDEO_LIST_URL=
# Optional: cache tuning. Default 12h matches TikTok's documented sync cadence.
# TIKTOK_REELS_TTL_MS=
# TIKTOK_REELS_MAX_ITEMS=24
# Legacy: the pre-Display-API social feed in business.html still reads this
# handle. Leave empty once Reels is the primary surface.
TIKTOK_USERNAME=
